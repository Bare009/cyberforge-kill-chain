# Copy to .env and fill in. Every key is optional: a missing key only skips that
# provider or agent, and the run still finishes. Never commit .env.

# ── Threat intel (track B, P9) ───────────────────────────────────────────────
OTX_API_KEY=
ABUSEIPDB_API_KEY=
VIRUSTOTAL_API_KEY=
GREYNOISE_API_KEY=
ABUSECH_AUTH_KEY=
# Optional: GeoLite2 download; without it GeoIP uses ip-api.com
MAXMIND_LICENSE_KEY=

# ── LLM agents (track B, P10b) ───────────────────────────────────────────────
# Primary: Groq (OpenAI-compatible)
LLM_PRIMARY_BASE_URL=https://api.groq.com/openai/v1
LLM_PRIMARY_API_KEY=
LLM_PRIMARY_MODEL_LARGE=openai/gpt-oss-120b
LLM_PRIMARY_MODEL_SMALL=openai/gpt-oss-20b
# (Groq retired the Llama models for free keys on 2026-08-16; gpt-oss settings are in config/llm.yaml)
# Fallback: NeevCloud (values from its dashboard; Llama 3.3 70B large, Llama 3.1 8B Instant small)
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL_LARGE=
LLM_FALLBACK_MODEL_SMALL=
# Stay under the provider's free-tier limits
LLM_MAX_REQUESTS_PER_MINUTE=20
LLM_ENABLED=false

# ── Paths ────────────────────────────────────────────────────────────────────
KILLCHAIN_DATA_DIR=data
KILLCHAIN_RUN=sample-run

# ── SIEM connections (killchain/connectors) ──────────────────────────────────
# API-pull poller inside the API process (1 = on, the default; 0 = off)
KILLCHAIN_CONNECTORS=1
# Fernet key(s) that encrypt API-pull credentials; comma-separate to rotate (first encrypts).
# Empty: a key is generated once into data/connectors/.credentials_key (demo only).
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CONNECTOR_CREDENTIALS_KEY=
# Base of the webhook URLs shown in Settings. Empty: the address the request came in on
# (Docker sets http://localhost:${API_PORT}).
INGEST_PUBLIC_BASE_URL=
# API pull targets: allow http:// and private / loopback addresses (on-prem sources).
# Link-local (cloud metadata) is always refused.
COLLECTOR_ALLOW_HTTP=false
COLLECTOR_ALLOW_PRIVATE_TARGETS=false
# Syslog listener (plain UDP/TCP, senders matched to a connector by allowed CIDR). Off by default.
KILLCHAIN_SYSLOG=0
SYSLOG_BIND=0.0.0.0
SYSLOG_UDP_PORT=5514
SYSLOG_TCP_PORT=5514
# Host and port shown in Settings for syslog (default: the API host, the ports above)
SYSLOG_PUBLIC_HOST=
