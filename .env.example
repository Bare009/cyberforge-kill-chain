# Copy to .env and fill in. Every key is optional: a missing key only skips that
# provider or agent, and the run still finishes. Never commit .env.

# ── Threat intel (track B, P9) ───────────────────────────────────────────────
OTX_API_KEY=
ABUSEIPDB_API_KEY=
VIRUSTOTAL_API_KEY=
GREYNOISE_API_KEY=
ABUSECH_AUTH_KEY=
# Optional: GeoLite2 download; without it GeoIP uses ip-api.com
MAXMIND_LICENSE_KEY=

# ── LLM agents (track B, P10b) ───────────────────────────────────────────────
# Primary: Groq (OpenAI-compatible)
LLM_PRIMARY_BASE_URL=https://api.groq.com/openai/v1
LLM_PRIMARY_API_KEY=
LLM_PRIMARY_MODEL_LARGE=llama-3.3-70b-versatile
LLM_PRIMARY_MODEL_SMALL=llama-3.1-8b-instant
# Fallback: NeevCloud (values from its dashboard)
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL_LARGE=
LLM_FALLBACK_MODEL_SMALL=
# Stay under the provider's free-tier limits
LLM_MAX_REQUESTS_PER_MINUTE=20
LLM_ENABLED=false

# ── Paths ────────────────────────────────────────────────────────────────────
KILLCHAIN_DATA_DIR=data
KILLCHAIN_RUN=sample-run
